<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_transferir.xml
    CAMBIO: se agrego el boton "+" (btn_agregar_contacto) en la barra superior
    para navegar a AgregarContactoActivity.
    IDs: btn_cerrar, btn_agregar_contacto, et_buscar, rv_contactos.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Barra superior con título, cerrar y botón + -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btn_cerrar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="Cerrar"/>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Enviar dinero"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <!-- Botón + para agregar nuevo contacto -->
        <TextView
            android:id="@+id/btn_agregar_contacto"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_dark"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/purple_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Agregar contacto"/>
    </LinearLayout>

    <!-- Sección de búsqueda -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#191;A quien le quieres enviar?"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Busca un contacto o agrega uno nuevo con +"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="16dp"/>

        <!-- Campo de búsqueda -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/card_dark"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:text="&#128269;"
                android:textSize="16sp"/>

            <EditText
                android:id="@+id/et_buscar"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:hint="Buscar por nombre"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:background="@null"
                android:textSize="15sp"
                android:inputType="text"
                android:paddingStart="8dp"/>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_color"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Contactos frecuentes"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="4dp"/>
    </LinearLayout>

    <!-- Lista de contactos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_contactos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="12dp"
        android:clipToPadding="false"/>

</LinearLayout>
